# krew plugin manifest, rendered by packaging/render.sh for each release.
# Submitted to https://github.com/kubernetes-sigs/krew-index as plugins/kscope.yaml.
#
#   kubectl krew install kscope && kubectl kscope
apiVersion: krew.googlecontainertools.github.com/v1alpha2
kind: Plugin
metadata:
  name: kscope
spec:
  version: v@VERSION@
  homepage: https://github.com/hknerts/kscope
  shortDescription: Read-only TUI for logs, metrics and events across clusters
  description: |
    kscope is a fast, read-only terminal UI for Kubernetes. Browse any
    resource, CRDs included, then read its logs, metrics, events and a
    describe view. A Deployment merges the logs of all its replicas, and a
    fleet (-u stg) lists and streams from several clusters at once.
    It has no mutating code at all: no edit, scale, delete or exec, so it is
    safe to hand to anyone with a view-only token.
  caveats: |
    The metrics tab needs metrics-server in the cluster. Everything else
    works without it.
  platforms:
    - selector:
        matchLabels:
          os: darwin
          arch: arm64
      uri: https://github.com/hknerts/kscope/releases/download/@VERSION@/kscope-aarch64-apple-darwin.tar.gz
      sha256: @SHA256_aarch64-apple-darwin@
      files:
        - from: kscope
          to: .
        - from: LICENSE
          to: .
      bin: kscope
    - selector:
        matchLabels:
          os: darwin
          arch: amd64
      uri: https://github.com/hknerts/kscope/releases/download/@VERSION@/kscope-x86_64-apple-darwin.tar.gz
      sha256: @SHA256_x86_64-apple-darwin@
      files:
        - from: kscope
          to: .
        - from: LICENSE
          to: .
      bin: kscope
    - selector:
        matchLabels:
          os: linux
          arch: arm64
      uri: https://github.com/hknerts/kscope/releases/download/@VERSION@/kscope-aarch64-unknown-linux-gnu.tar.gz
      sha256: @SHA256_aarch64-unknown-linux-gnu@
      files:
        - from: kscope
          to: .
        - from: LICENSE
          to: .
      bin: kscope
    - selector:
        matchLabels:
          os: linux
          arch: amd64
      uri: https://github.com/hknerts/kscope/releases/download/@VERSION@/kscope-x86_64-unknown-linux-gnu.tar.gz
      sha256: @SHA256_x86_64-unknown-linux-gnu@
      files:
        - from: kscope
          to: .
        - from: LICENSE
          to: .
      bin: kscope
    - selector:
        matchLabels:
          os: windows
          arch: amd64
      uri: https://github.com/hknerts/kscope/releases/download/@VERSION@/kscope-x86_64-pc-windows-msvc.zip
      sha256: @SHA256_x86_64-pc-windows-msvc@
      files:
        - from: kscope.exe
          to: .
        - from: LICENSE
          to: .
      bin: kscope.exe
